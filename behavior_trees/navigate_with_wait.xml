<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <Wait wait_duration="2"/>
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker" path_handler_id="PathHandler"/>
    </Sequence>
  </BehaviorTree>
</root>
